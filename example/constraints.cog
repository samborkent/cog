package main

// ---------------------------------------------------------------------------
// fixed  = int + uint
// ---------------------------------------------------------------------------

// Generic type with fixed constraint: accepts any signed or unsigned integer.
FixedSlice<T ~ fixed> ~ []T

useFixed : func() = {
    xs : FixedSlice<int8> = {1, 2, 3}
    @print(xs)

    ys : FixedSlice<uint64> = {10, 20}
    @print(ys)
}

// ---------------------------------------------------------------------------
// real  = fixed + float  =  int + uint + float
// ---------------------------------------------------------------------------

RealSlice<T ~ real> ~ []T

useReal : func() = {
    xs : RealSlice<int32> = {-1, 0, 1}
    @print(xs)

    ys : RealSlice<float64> = {1.5, 2.5}
    @print(ys)

    zs : RealSlice<uint8> = {100}
    @print(zs)
}

