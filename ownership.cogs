// ownership.cogs — edge-case analysis of the Cog ownership model
//
// Scenarios that test the boundaries of the model. Each is annotated with
// whether it SHOULD compile, referencing the relevant rule.
//
// All holes from the original audit are addressed by rules 1-35 in
// ownership_model.md. This file captures the remaining nuance cases that
// the model handles correctly but which may not be obvious at first glance.

Point ~ struct { x : int64; y : int64 }
Container ~ struct { data : []int64; label : utf8 }

// ── 1. Partial move + re-assignment revives the struct ──
// After c.data is consumed, assigning a new value to c.data makes the
// struct whole again. It can then be passed to a proc.

main_revive : proc() = {
    c : var Container = Container{data: @slice<int64>(3), label: "hello"}
    d := c.data                     // c.data consumed
    // worker(c)                    // compile error — c.data dead
    c.data = @slice<int64>(5)       // re-assign — c.data alive again
    worker(c)                       // OK — all fields alive
}

worker : proc(data : Container) = { /* ... */ }

// ── 2. Partial borrow + mutate other field ──
// When passed to a func, the whole struct is borrowed. But when only
// a specific field is accessed (e.g. &c.data), the borrow is narrower.

main_partial_borrow : proc() = {
    c : var Container = Container{data: @slice<int64>(3), label: "hello"}

    r := &c.data                    // borrows c.data specifically (rule 31)
    c.label = "bye"                 // OK — c.label not borrowed

    // r must die before c.data can be mutated again
    @print(r[0])
    c.data[0] = 99                  // OK — r is no longer used
}

// ── 3. Enum match without consumption (borrow match) ──
// Rule 29 says a var enum transfers payload ownership when matched.
// But if the match only borrows (the match binds are immutable), the
// enum variable should survive.

Result ~ enum<int8> {
    Ok := 0 with value : utf8;
    Err := 1 with msg : utf8
}

main_enum_borrow : proc() = {
    r : var Result = Result.Ok("hello")
    match r {
        case Ok(val) => {           // val is immutable borrow
            @print(val)
        }
        case Err(msg) => {
            @print(msg)
        }
    }
    // r is alive here — borrow released
    // But: does the model distinguish "consume match" (rule 29) from
    // "borrow match"? If match arms receive immutable bindings, the
    // enum ought to be borrowed (rule 9 analog). This is a subtle
    // distinction the model should clarify.
}

// ── 4. Arena allocation + partial move ──
// Arena provenance is a property of the VALUE, not the variable.
// If an arena-allocated struct has a field moved out, the field
// value retains its arena provenance. The new owner is responsible
// for the arena lifetime constraint (rule 30).

main_arena_partial : proc() = {
    arena := @new_arena()
    c : var Container = Container{data: @arena_slice<int64>(arena, 3), label: "hello"}

    d := c.data                     // partial move — d is arena-allocated

    async worker_arena(d)           // compile error (rule 30) — d is arena
    // @free_arena(arena)
}

worker_arena : proc(data : []int64) = {
    @print(data[0])
}

// ── 5. Map key of var pointer-like type ──
// If the key itself is var and pointer-like, insertion consumes it.
// The value is also consumed. This is already covered by rule 34.

main_map_key_var : proc() = {
    m : var map[[]int64]utf8 = @map<[]int64, utf8>()
    key : var []int64 = @slice<int64>(3)
    key[0] = 42

    m[key] = "found"                // key consumed (rule 34)
    // key is dead
}

// ── 6. Chained method that mutates in-place ──
// If sort() mutates self and returns &self, the chain borrows `items`
// for the entire chain (rule 35). After the chain, items is alive.

main_chain : proc() = {
    items : var []int64 = []int64{3, 1, 2}
    result := items.sort().reverse()
    items[0] = 99                   // OK — borrow released
}

// ── 7. All-consumed match on var enum ──
// When all match arms consume the payload, the enum variable is dead
// after the match (rule 24 analog, via rule 29).

main_enum_consume : proc() = {
    r : var Result = Result.Ok("hello")
    match r {
        case Ok(val) => {
            @print(val)             // val borrowed (not consumed)
        }
        case Err(msg) => {
            @print(msg)
        }
    }
    // r is alive — nothing was consumed
}

// ── 8. defer + partial move ──
// If defer closes over a var field, does it consume the whole struct
// or just the field? Rule 33 says defer consumes var variables.
// If the defer captures `c.data`, it should consume `c.data`
// specifically (or the whole `c` if it references `c`).

main_defer_field : proc() = {
    c : var Container = Container{data: @slice<int64>(3), label: "hello"}
    defer cleanup(c.data)           // c.data consumed by defer
    // c.data is dead
    // c.label is still alive
}

cleanup : proc(data : []int64) = { /* ... */ }

// ── 9. Conditional with partial moves ──
// Rule 24 (consumption in ANY branch kills the variable) interacts
// with partial moves (rule 21). If c.data is consumed in one branch
// and borrowed in another, c.data is dead after the conditional.
// But c.label remains alive.

main_cond_partial : proc() = {
    c : var Container = Container{data: @slice<int64>(3), label: "hello"}
    if true {
        d := c.data                 // c.data consumed
    } else {
        @print(c.data[0])           // c.data borrowed
    }
    // c.data is dead (rule 24 — conservative)
    @print(c.label)                 // OK — label still alive
}

// ── 10. Return of var struct after partial move ──
// Returning a struct where one field is dead should be a compile error,
// just like passing to a proc.

main_return_partial : proc() var Container = {
    c : var Container = Container{data: @slice<int64>(3), label: "hello"}
    d := c.data                     // c.data consumed
    // return c                     // compile error — c.data dead
    c.data = @slice<int64>(5)       // re-assign
    return c                        // OK — all fields alive
}