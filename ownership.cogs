// ownership.cogs — edge-case analysis of the Cog ownership model
//
// Scenarios that test the boundaries of the model. Each is annotated with
// whether it SHOULD compile, referencing the relevant rule.

Point ~ struct {
    x : int64
    y : int64
}
Container ~ struct { data : []int64; label : utf8 }

// ── 1. Partial move + re-assignment revives the struct ──
// After c.data is consumed, assigning a new value to c.data makes the
// struct whole again. It can then be passed to a proc.

main_revive : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    d := c.data                     // c.data consumed
    // worker(c)                    // compile error — c.data dead
    c.data = @slice<int64>(5)       // re-assign — c.data alive again
    worker(c)                       // OK — all fields alive
}

worker : proc(data : Container) = { /* ... */ }

// ── 2. Partial borrow + mutate other field ──
// When passed to a func, the whole struct is borrowed. But when only
// a specific field is accessed (e.g. &c.data), the borrow is narrower.

main_partial_borrow : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }

    r := &c.data                    // borrows c.data specifically (rule 22)
    c.label = "bye"                 // OK — c.label not borrowed

    // r must die before c.data can be mutated again
    @print(r[0])
    c.data[0] = 99                  // OK — r is no longer used
}

// ── 3. Enum match without consumption (borrow match) ──
// Rule 20 says a var enum transfers payload ownership when matched.
// But if the match only borrows (the match binds are immutable), the
// enum variable should survive.

Result ~ enum<int8> {
    Ok := 0,
    Err := 1,
}

main_enum_borrow : proc() = {
    r : var Result = Result.Ok
    switch r {
    case Result.Ok:           // val is immutable borrow
        @print(val)
    case Result.Err:
        @print(msg)
    }
    // r is alive here — borrow released
    // But: does the model distinguish "consume match" (rule 20) from
    // "borrow match"? If match arms receive immutable bindings, the
    // enum ought to be borrowed (rule 7 analog). This is a subtle
    // distinction the model should clarify.
}

// ── 4. Map key of var pointer-like type ──
// If the key itself is var and pointer-like, insertion consumes it.
// The value is also consumed. This is already covered by rule 24.
//
// NOTE: slices are NOT comparable in Go, so they cannot be map keys.
// Using a struct with a single slice field would also fail the comparable
// check for the same reason. Use a string/utf8 key, or a generic type
// constrained by `comparable`, or a cog.Set instead.

main_map_key_var : proc() = {
    m : var map[utf8]var []int64 = @map<utf8, []int64>()
    key : utf8 = "items"
    val : var []int64 = @slice<int64>(3)
    val[0] = 42

    m[key] = val                    // key consumed (immutable shallow copy), val consumed (rule 24)
    // key is dead
    // val is dead
}

// ── 5. Chained method that mutates in-place ──
// If sort() mutates self and returns &self, the chain borrows `items`
// for the entire chain (rule 25). After the chain, items is alive.

main_chain : proc() = {
    items : var []int64 = []int64{3, 1, 2}
    result := items.sort().reverse()
    items[0] = 99                   // OK — borrow released
}

// ── 6. All-consumed match on var enum ──
// When all match arms consume the payload, the enum variable is dead
// after the match (rule 16 analog, via rule 20).

main_enum_consume : proc() = {
    r : var Result = Result.Ok
    switch r {
    case Result.Ok:
        @print(val)             // val borrowed (not consumed)
    case Result.Err(msg):
        @print(msg)
    }
    // r is alive — nothing was consumed
}

// ── 7. defer reserves var — variable must survive to scope exit ──
// The deferred call runs at scope exit, so the variable must stay alive
// through all intervening code. Any consumption/move of the reserved
// variable after the defer is a compile error (the defer would find it
// dead). Multiple defers on the same variable are also rejected.

main_defer_reassigned_after : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    defer cleanup(c.data)            // compile error — c.data is consumed below
    c.data = @slice<int64>(5)        // c.data consumed
}

main_defer_ok : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    defer cleanup(c.data)            // OK — no consumption of c.data after this
    c.label = "bye"                  // OK — c.label not reserved
}

main_defer_double : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    defer cleanup(c.data)            // compile error — c.data already reserved below
    defer cleanup(c.data)            // reserves c.data (first-to-execute)
}

main_defer_already_dead : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    d := c.data                      // c.data consumed
    defer cleanup(c.data)            // compile error — c.data already dead
}

cleanup : proc(data : []int64) = { /* ... */ }

// ── 8. Conditional with partial moves ──
// Rule 16 (consumption in ANY branch kills the variable) interacts
// with partial moves (rule 19). If c.data is consumed in one branch
// and borrowed in another, c.data is dead after the conditional.
// But c.label remains alive.

main_cond_partial : proc() = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    if true {
        d := c.data                 // c.data consumed
    } else {
        @print(c.data[0])           // c.data borrowed
    }
    // c.data is dead (rule 16 — conservative)
    @print(c.label)                 // OK — label still alive
}

// ── 9. Return of var struct after partial move ──
// Returning a struct where one field is dead should be a compile error,
// just like passing to a proc.

main_return_partial : proc() var Container = {
    c : var Container = Container{
        data = @slice<int64>(3),
        label = "hello",
    }
    d := c.data                     // c.data consumed
    // return c                     // compile error — c.data dead
    c.data = @slice<int64>(5)       // re-assign
    return c                        // OK — all fields alive
}